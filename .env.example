# Copy this file to .env and add your Groq API key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_USE_ENV_PROXY=false
LLM_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_FACT_CHECK_API_KEY=
NASA_API_KEY=
NOAA_API_TOKEN=
MAX_CLAIMS=8
MAX_EVIDENCE_PER_CLAIM=3
MAX_TOTAL_EVIDENCE=20
MAX_LLM_RESPONSE_TOKENS=256
EVIDENCE_RELEVANCE_THRESHOLD=0.55
NLI_BATCH_SIZE=8
NLI_MAX_LENGTH=256
NLI_DEVICE=auto
SOURCE_CACHE_TTL=3600
VERIFICATION_MODE=BALANCED

# Hybrid retrieval
ENABLE_WIKIPEDIA_FALLBACK=true
LOCAL_SIMILARITY_THRESHOLD=0.60
MAX_WIKIPEDIA_CHUNKS=3
WIKIPEDIA_REQUEST_TIMEOUT=10
WIKIPEDIA_USER_AGENT=HaluCheck/1.0 (Educational Project)
RETRIEVAL_MODE=current
